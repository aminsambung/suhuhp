<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#1A1A1A"
    android:padding="20dp">

    <!-- ===== TAMPILAN SMARTWATCH ===== -->
    <LinearLayout
        android:layout_width="300dp"
        android:layout_height="340dp"
        android:orientation="vertical"
        android:background="@drawable/latar_jam"
        android:padding="18dp">

        <!-- Tanggal -->
        <TextView
            android:id="@+id/teksTanggal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RAB\n04/06"
            android:textColor="#333333"
            android:textSize="14sp"
            android:textStyle="bold"
            android:lineSpacingExtra="2dp"/>

        <!-- Jam Besar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end|center_vertical"
            android:layout_marginTop="-45dp">

            <TextView
                android:id="@+id/teksJam"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="09"
                android:textColor="#1A1A1A"
                android:textSize="80sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-black"/>

            <TextView
                android:id="@+id/teksMenit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="40"
                android:textColor="#E67E22"
                android:textSize="80sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-black"/>
        </LinearLayout>

        <!-- Suhu HP -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🌡️"
                android:textSize="18sp"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="8dp">

                <TextView
                    android:id="@+id/teksSuhuHp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="36.5°C"
                    android:textColor="#333333"
                    android:textSize="18sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SUHU HP"
                    android:textColor="#666666"
                    android:textSize="10sp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Suhu CPU + Baterai -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="20dp"
            android:gravity="center_vertical"
            android:weightSum="2">

            <!-- Suhu CPU -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/teksSuhuCpu"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="42.0"
                        android:textColor="#1A1A1A"
                        android:textSize="20sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" 🔥"
                        android:textSize="14sp"/>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SUHU CPU"
                    android:textColor="#666666"
                    android:textSize="10sp"/>
            </LinearLayout>

            <!-- Baterai -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/teksBaterai"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚡ 50%"
                    android:textColor="#1A1A1A"
                    android:textSize="20sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DAYA"
                    android:textColor="#666666"
                    android:textSize="10sp"/>
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

    <!-- Status Suhu -->
    <TextView
        android:id="@+id/teksStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="✅ Suhu Normal"
        android:textColor="#4CAF50"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginTop="24dp"/>

    <!-- Tombol Segarkan -->
    <Button
        android:id="@+id/tombolSegarkan"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🔄 Segarkan Suhu"
        android:backgroundTint="#2196F3"
        android:layout_marginTop="16dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tambahkan widget ke layar utama\nuntuk lihat suhu real-time"
        android:textColor="#888888"
        android:textSize="12sp"
        android:gravity="center"
        android:layout_marginTop="24dp"/>

</LinearLayout>
