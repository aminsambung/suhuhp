<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/latar_widget">

    <!-- BARIS ATAS: Tanggal & Jam Besar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Tanggal (KIRI) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/wHari"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MIN"
                android:textColor="#333333"
                android:textSize="12sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/wTanggal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="11/10"
                android:textColor="#333333"
                android:textSize="12sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <!-- Jam Besar (KANAN) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/wJam"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="09"
                android:textColor="#1A1A1A"
                android:textSize="36sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-black"/>

            <TextView
                android:id="@+id/wMenit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="40"
                android:textColor="#E67E22"
                android:textSize="36sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-black"/>
        </LinearLayout>
    </LinearLayout>

    <!-- BARIS TENGAH: Suhu HP (ganti step) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🌡️"
            android:textSize="14sp"/>

        <TextView
            android:id="@+id/wSuhuHp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="36.3°C"
            android:textColor="#1A1A1A"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginStart="6dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" SUHU HP"
            android:textColor="#666666"
            android:textSize="9sp"/>
    </LinearLayout>

    <!-- BARIS BAWAH: Suhu CPU & Baterai -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:weightSum="2">

        <!-- Suhu CPU -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/wSuhuCpu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="42.0°C"
                android:textColor="#1A1A1A"
                android:textSize="14sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" 🔥"
                android:textSize="12sp"/>
        </LinearLayout>

        <!-- Baterai -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="end|center_vertical">

            <TextView
                android:id="@+id/wBaterai"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="86%"
                android:textColor="#1A1A1A"
                android:textSize="14sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" ⚡"
                android:textSize="12sp"/>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
